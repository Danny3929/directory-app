# Copy this file to .env for local work. Never commit .env.
# Make a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Change to True only in your own .env on your laptop, to see error pages.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave out to use backend/db.sqlite3. On a server: postgres://user:password@host:5432/name
# DATABASE_URL=sqlite:///db.sqlite3
