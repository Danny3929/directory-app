# Copy this file to .env for local work. Never commit .env.
# Make a key with: python -c "import secrets; print(secrets.token_urlsafe(50))"
DJANGO_SECRET_KEY=change-me
# Change to True only in your own .env on your laptop, to see error pages.
DJANGO_DEBUG=False
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
# Leave out to use backend/db.sqlite3. On a server: postgres://user:password@host:5432/name
# DATABASE_URL=sqlite:///db.sqlite3
# Stripe TEST mode only (sk_test_..., whsec_...). Live keys stop the server starting.
# Leave empty to run without Stripe: checkout then answers 503.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Where Stripe sends owners back after paying.
FRONTEND_URL=http://localhost:5173
# Server only: HTTPS redirect, HSTS and Render's X-Forwarded-Proto. Leave out on a laptop.
# DJANGO_HTTPS=True
# Server only: proxies in front of Django, so each visitor gets their own rate limit.
# NUM_PROXIES=1
# Server only: photos go to Cloudinary instead of the disk (cloudinary://key:secret@cloud).
# CLOUDINARY_URL=
